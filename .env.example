# AI Doubt Solver - Environment Configuration

# Gemini API Key for Doubt Solving (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# App Base URL (used in email password reset links)
APP_BASE_URL=http://localhost:8501

# Development Mode (true prints reset links & dev helpers to console and UI banner; false disables them)
DEV_MODE=true

# SMTP Configuration for sending real password reset emails (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME="AI Doubt Solver"

# Session Timeout in minutes (default 60)
SESSION_TIMEOUT_MINUTES=60

# Rate limits
MAX_RESET_REQUESTS_PER_HOUR=3
AI_REQUEST_COOLDOWN_SECONDS=3
